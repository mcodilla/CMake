include(RunCMake)

function(run_build name result calls logs database)
  set(RunCMake_TEST_NO_CLEAN 1)
  set(RunCMake_TEST_OUTPUT_MERGE 1)
  set(RunCMake_TEST_EXPECT_RESULT "^${result}$")
  set(RunCMake-check-file Build-check.cmake)
  set(expected_calls "${calls}")
  set(expected_logs "${logs}")
  set(expected_database "${database}")
  set(expect_retained "${result}")
  run_cmake_command("${name}" "${CMAKE_COMMAND}" --build "${RunCMake_TEST_BINARY_DIR}"
    --config Debug ${ARGN})
endfunction()

function(check_configure)
  if(EXISTS "${RunCMake_TEST_BINARY_DIR}/compile_commands.json"
      OR EXISTS "$ENV{CMAKE_TEST_EXTRACTOR_ARGS}")
    message(FATAL_ERROR "Configure invoked the extractor or generated a database")
  endif()
endfunction()

set(RunCMake_TEST_BINARY_DIR "${RunCMake_BINARY_DIR}/Extractor build")
set(RunCMake_TEST_OPTIONS -DCMAKE_EXPORT_COMPILE_COMMANDS=OFF -DCMAKE_CONFIGURATION_TYPES=Debug)
run_cmake(Extractor)
set(RunCMake_TEST_NO_CLEAN 1)
run_cmake_command(Extractor-build "${CMAKE_COMMAND}" --build "${RunCMake_TEST_BINARY_DIR}"
  --config Debug --target msbuild-extractor-tool)
unset(RunCMake_TEST_NO_CLEAN)
include("${RunCMake_TEST_BINARY_DIR}/extractor-Debug.cmake")
set(ENV{PATH} "${extractor_dir};$ENV{PATH}")

unset(ENV{CMAKE_EXPORT_COMPILE_COMMANDS})
set(ENV{CMAKE_TEST_EXTRACTOR_MODE} 2)
set(RunCMake_TEST_BINARY_DIR "${RunCMake_BINARY_DIR}/CacheOn build")
set(ENV{CMAKE_TEST_EXTRACTOR_ARGS} "${RunCMake_TEST_BINARY_DIR}/extractor-args.txt")

run_build(ExportFailure-build 1 3 4 "previous snapshot" --target first)
set(ENV{CMAKE_TEST_EXTRACTOR_MODE} 2)
run_build(NativeFailure-build 1 4 6 "from extractor" --target first broken)
run_build(CleanFirst-build 0 5 8 "from extractor" --clean-first --target first)

set(ENV{CMAKE_EXPORT_COMPILE_COMMANDS} ON)

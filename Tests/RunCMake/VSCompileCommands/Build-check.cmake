set(database "${RunCMake_TEST_BINARY_DIR}/compile_commands.json")
if(expected_database STREQUAL "")
  if(EXISTS "${database}")
    set(RunCMake_TEST_FAILED "Unexpected compilation database")
    return()
  endif()
else()
  if(NOT EXISTS "${database}")
    set(RunCMake_TEST_FAILED "Compilation database was not published")
    return()
  endif()
  file(READ "${database}" content)
  if(NOT content STREQUAL "${expected_database}\n")
    set(RunCMake_TEST_FAILED "Wrong database contents: ${content}")
    return()
  endif()
endif()

set(calls 0)
set(logs "")
if(EXISTS "$ENV{CMAKE_TEST_EXTRACTOR_ARGS}")
  file(READ "$ENV{CMAKE_TEST_EXTRACTOR_ARGS}" arguments)
  string(REGEX MATCHALL "BEGIN\n" invocations "${arguments}")
  list(LENGTH invocations calls)
  file(STRINGS "$ENV{CMAKE_TEST_EXTRACTOR_ARGS}" logs REGEX "\\.binlog$")
  if(NOT arguments MATCHES "--export-compile-commands\n--variant-policy\nfirst\n--allow-failed-build\n--output-file\n")
    set(RunCMake_TEST_FAILED "Missing extractor arguments:\n${arguments}")
    return()
  endif()
endif()
list(LENGTH logs log_count)
list(REMOVE_DUPLICATES logs)
list(LENGTH logs unique_logs)
if(NOT calls EQUAL expected_calls OR NOT log_count EQUAL expected_logs
    OR NOT unique_logs EQUAL log_count)
  set(RunCMake_TEST_FAILED
    "Expected ${expected_calls} extractor calls and ${expected_logs} unique logs; got ${calls}, ${log_count}, ${unique_logs}")
endif()
if(expect_retained AND logs)
  list(GET logs -1 last_log)
  if(NOT EXISTS "${last_log}")
    set(RunCMake_TEST_FAILED "Failure capture was not retained: ${last_log}")
  endif()
endif()
